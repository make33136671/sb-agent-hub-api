[Unit]
Description=Sb.Apps.AgentHub api

[Service]
#工作目录
WorkingDirectory=/www/wwwroot/saibo_kefu_api/
#执行启动命令
ExecStart=/snap/dotnet-sdk/current/dotnet /www/wwwroot/saibo_kefu_api/Sb.Apps.AgentHub.WebApi.dll --urls='http://127.0.0.1:6020'
#重启类型。always 服务退出立即重启。 no 服务退出不会重启。 on-failure 非正常退出即重启程序
Restart=always
#重启时间 服务退出后5秒自动重启
RestartSec=2
#重启次数 0为无限重启
StartLimitInterval=0
#Dotnet环境变量
Environment=ASPNETCORE_ENVIRONMENT=Production

#配置此项可设置为开机自动启动服务,但需要手动设置  systemctl enable ShopAPI
[Install]
WantedBy=multi-user.target