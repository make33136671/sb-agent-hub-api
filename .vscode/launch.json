{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SbAgentHub API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/SbAgentHub.API/bin/Debug/net8.0/SbAgentHub.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/SbAgentHub.API",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        },
        {
            "name": "Attach to Process",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
