{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Sb.Apps.AgentHub API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Sb.Apps.AgentHub.WebApi/bin/Debug/net8.0/Sb.Apps.AgentHub.WebApi.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Sb.Apps.AgentHub.WebApi",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        },
        {
            "name": "Attach to Process",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
