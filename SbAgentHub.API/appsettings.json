{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "RollingFile",
              "Args": {
                "pathFormat": "logs/error-{Date}.txt",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
                "restrictedToMinimumLevel": "Error"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "RollingFile",
              "Args": {
                "pathFormat": "logs/info-{Date}.txt",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
                "restrictedToMinimumLevel": "Information",
                "restrictedToMaximumLevel": "Information"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "RollingFile",
              "Args": {
                "pathFormat": "logs/warning-{Date}.txt",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
                "restrictedToMinimumLevel": "Warning",
                "restrictedToMaximumLevel": "Warning"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AppName": "赛博客服系统",
  "Debug": true,
  "DbConfig": {
    "Server": "192.168.10.100",
    "Port": "3306",
    "Database": "SbAgentHub",
    "User": "root",
    "Password": "111111",
    "AutoSyncStructure": true,
    "MonitorSqlCommandForLog": false,
    "SlowQueryThresholdMs": 200
  },
  "OpenIM": {
    "ImApiUrl": "http://192.168.10.231:10002",
    "ImWsUrl": "ws://192.168.10.231:10001",
    "ClientApiUrl": "http://192.168.10.231:10002",
    "ClientWsUrl": "ws://192.168.10.231:10001",
    "AdminUserId": "imAdmin",
    "Secret": "openIM123"
  },
  "CacheConfig": {
    "Enabled": false,
    "Provider": "Memory",
    "Redis": {
      "Connection": "localhost:6379",
      "InstanceName": "SbAgentHub:"
    }
  },
  "PasswordConfig": {
    "StorageMode": "Encrypted"
  },
  "UploadConfig": {
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".bmp",
      ".webp",
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx"
    ],
    "UploadPath": "/upload/"
  },
  "RateLimitConfig": {
    "WindowSeconds": 60,
    "PermitLimit": 10
  },
  "CorsConfig": {
    "AllowAll": true,
    "Origins": []
  },
  "JwtAdmin": {
    "Key": "oS/RAt0rR5BTO8+mocZxE0PqXaxeCY8gGS8JmGdr5L0=",
    "Issuer": "qinglongAdminAPI",
    "Audience": "qinglongAdmin",
    "Expires": "1440"
  },
  "JwtApi": {
