{
  "AppName": "赛博管理系统",
  "Debug": true,
  "UseSwagger": true,
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "RollingFile",
              "Args": {
                "pathFormat": "logs/debug-{Date}.txt",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "DbConfig": {
    "Server": "192.168.10.100",
    "Port": "3306",
    "Database": "SbAgentHub",
    "User": "root",
    "Password": "111111",
    "AutoSyncStructure": true,
    "MonitorSqlCommandForLog": true,
    "SlowQueryThresholdMs": 100
  },
  "CacheConfig": {
    "Provider": "Memory",
    "Redis": {
      "Connection": "192.168.10.100:6379",
      "InstanceName": "SB:"
    }
  },
  "UploadConfig": {
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".bmp",
      ".webp",
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx"
    ],
    "UploadPath": "/upload/"
  },
  "JwtAdmin": {
    "Key": "VfS2Cj9vvBTrXHy7CW+oz9Krx20roXfF", //秘钥
    "Issuer": "qinglongAdminAPI", //签发者
    "Audience": "qinglongAdmin", //使用者
    "Expires": "1440" //有效时间(分钟)
  },
  "JwtApi": {
    "Key": "VfS2Cj9vvBTrXHy7CW+oz9Krx20roXf4F", //秘钥
    "Issuer": "qinglongAPI", //签发者
    "Audience": "qinglongAPI", //使用者
    "Expires": "10080" //有效时间(分钟)
  }
}