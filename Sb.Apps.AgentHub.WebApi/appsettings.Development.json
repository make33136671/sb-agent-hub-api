{
  "ForceHttps": true,
  "AppName": "赛博管理系统",
  "Debug": true,
  "UseSwagger": true,
  "DetailedErrors": true,
  "ExposeErrorDetails": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "RollingFile",
              "Args": {
                "pathFormat": "logs/debug-{Date}.txt",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "DbConfig": {
    "DbType": "PostgreSql",
    "Server": "172.25.167.196",
    "Port": "5432",
    "Database": "sb_agent_hub",
    "User": "postgres",
    "Password": "LDHbd4f2YLx3anLK",
    "AutoSyncStructure": true,
    "MonitorSqlCommandForLog": true,
    "SlowQueryThresholdMs": 100
  },
  "CacheConfig": {
    "Provider": "Memory",
    "Redis": {
      "Connection": "192.168.10.100:6379",
      "InstanceName": "SB:"
    }
  },
  "UploadConfig": {
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".bmp",
      ".webp",
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx"
    ],
    "UploadPath": "/upload/"
  },
  "PasswordConfig": {
    "StorageMode": "PlainText"
  },
  "JwtAdmin": {
    "Key": "VfS2Cj9vvBTrXHy7CW+oz9Krx20roXfF",
    "Issuer": "qinglongAdminAPI",
    "Audience": "qinglongAdmin",
    "Expires": "1440"
  },
  "JwtApi": {
    "Key": "VfS2Cj9vvBTrXHy7CW+oz9Krx20roXf4F",
    "Issuer": "qinglongAPI",
    "Audience": "qinglongAPI",
    "Expires": "10080"
  }
}