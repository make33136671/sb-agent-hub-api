{
  "DetailedErrors": true,
  "ProductEn": "sbagenthub",
  "UseSwagger": true,
  "ExcludeControllers": [
    "SB.Framework.WebApi.Controllers.AuthController",
    "SB.Framework.WebApi.Controllers.LoginLogController",
    "SB.Framework.WebApi.Controllers.ManagerController",
    "SB.Framework.WebApi.Controllers.MemberController",
    "SB.Framework.WebApi.Controllers.MenuController",
    "SB.Framework.WebApi.Controllers.SystemSettingCategoryController",
    "SB.Framework.WebApi.Controllers.SystemSettingController"
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "RollingFile",
              "Args": {
                "pathFormat": "logs/error-{Date}.txt",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
                "restrictedToMinimumLevel": "Error"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "RollingFile",
              "Args": {
                "pathFormat": "logs/info-{Date}.txt",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
                "restrictedToMinimumLevel": "Information",
                "restrictedToMaximumLevel": "Information"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "RollingFile",
              "Args": {
                "pathFormat": "logs/warning-{Date}.txt",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
                "restrictedToMinimumLevel": "Warning",
                "restrictedToMaximumLevel": "Warning"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AppName": "赛博客服系统",
  "Debug": true,
  "ForceHttps": "${FORCE_HTTPS|true}",
  "DbConfig": {
    "Server": "${DB_SERVER|127.0.0.1}",
    "Port": "${DB_PORT|3306}",
    "Database": "${DB_NAME|sb_agent_hub}",
    "User": "${DB_USER|root}",
    "Password": "${DB_PASSWORD}",
    "AutoSyncStructure": false,
    "MonitorSqlCommandForLog": false,
    "SlowQueryThresholdMs": 200
  },
  "CacheConfig": {
    "Enabled": false,
    "Provider": "Memory",
    "Redis": {
      "Connection": "localhost:6379",
      "InstanceName": "Sb.Apps.AgentHub:"
    }
  },
  "PasswordConfig": {
    "StorageMode": "Encrypted"
  },
  "CloudConfig": {
    "ServerUrl": "https://cloud.saibo.club"
  },
  "UploadConfig": {
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".bmp",
      ".webp",
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx"
    ],
    "UploadPath": "/upload/"
  },
  "RateLimitConfig": {
    "WindowSeconds": 60,
    "PermitLimit": 10
  },
  "CorsConfig": {
    "AllowAll": true,
    "Origins": []
  },
  "JwtAdmin": {
    "Key": "${JWT_ADMIN_KEY}",
    "Issuer": "qinglongAdminAPI",
    "Audience": "qinglongAdmin",
    "Expires": "1440"
  },
  "JwtApi": {
    "Key": "${JWT_API_KEY}",
    "Issuer": "qinglongAPI",
    "Audience": "qinglongAPI",
    "Expires": "10080"
  },
  "Payment": {
    "Alipay": {
      "PublicKey": "${ALIPAY_PUBLIC_KEY}"
    },
    "Wechat": {
      "ApiKey": "${WECHAT_API_KEY}"
    }
  },
  "Chat": {
    "Realtime": {
      "WebSocketPath": "/hubs/realtime",
      "HeartbeatTimeout": "00:00:45",
      "HeartbeatInterval": "00:00:15",
      "MessageRetentionDays": 90,
      "MaxHistoryBatch": 100,
      "Reconnect": {
        "MaxRetries": 3,
        "BaseDelay": "00:00:01",
        "MaxDelay": "00:00:30",
        "JitterFactor": 0.2,
        "UseExponentialBackoff": true
      },
      "CircuitBreaker": {
        "FailureThreshold": 10,
        "ResetTimeout": "00:01:00",
        "SuccessThreshold": 3
      },
      "ConnectionRateLimit": {
        "MaxConnectionsPerMinute": 60,
        "MaxConnectionsPerUserMinute": 30
      }
    }
  }
}